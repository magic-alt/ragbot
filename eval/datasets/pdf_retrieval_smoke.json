  "defaults": {
    "top_k": 10,
    "filters": {
      "source_types": ["pdf"]
    }
  },
  "thresholds": {
    "hit_at_5_min": 0.66,
    "mrr_at_10_min": 0.4,
    "p95_search_ms_max": 5000
  },
