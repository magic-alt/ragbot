        "all_terms": ["LoRA", "QLoRA"],
        "max_rank": 5
      },
      "answer": {
        "contains_all": ["LoRA", "QLoRA"],
        "min_citations": 1
      }
    },
    {
      "id": "quantization-gpu-memory-en",
      "category": "english-technical",
