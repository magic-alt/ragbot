# Opt-in sparse retrieval runtime for the Docker Compose sparse overlays.
# Keep these values identical across API and worker replicas because the
# SparseEmbeddingSpec is part of the immutable IndexVersion contract.
RAGBOT_SPARSE_ENABLED=true
RAGBOT_SPARSE_PROVIDER=fastembed
RAGBOT_SPARSE_MODEL=Qdrant/bm25
RAGBOT_SPARSE_REVISION=
RAGBOT_SPARSE_VECTOR_NAME=sparse
RAGBOT_SPARSE_MODIFIER=idf
RAGBOT_SPARSE_TOKENIZER=
RAGBOT_SPARSE_LANGUAGE=
RAGBOT_SPARSE_BATCH_SIZE=32

# Existing dense/index settings still come from the normal Ragbot environment.
# Example for the locally validated candidate:
# EMBEDDING_MODEL=qwen3-embedding:8b
# QDRANT_DIM=4096
# QDRANT_INDEX_ALIAS=rag_chunks_qwen3_8b_4096_active
