# Ragbot local-development configuration.
# Copy to .env and fill secrets locally. Never commit .env.

# -----------------------------------------------------------------------------
# Runtime mode
# -----------------------------------------------------------------------------
RAGBOT_ENV=development

# Ingestion execution: auto uses the durable worker when POSTGRES_DSN is set and
# inline execution otherwise. Production forbids inline. Docker Compose sets
# this to worker and starts a dedicated worker service.
RAGBOT_INGESTION_MODE=auto
RAGBOT_WORKER_POLL_SECONDS=1
RAGBOT_WORKER_LEASE_SECONDS=120
RAGBOT_WORKER_MAX_ATTEMPTS=3
RAGBOT_WORKER_RETRY_BASE_SECONDS=5
RAGBOT_WORKER_RETRY_MAX_SECONDS=300
RAGBOT_RECONCILE_SECONDS=30
RAGBOT_SCHEDULER_SCAN_SECONDS=30
RAGBOT_PROVIDER_MAX_ATTEMPTS=4
RAGBOT_PROVIDER_BACKOFF_BASE_SECONDS=0.5
RAGBOT_PROVIDER_BACKOFF_MAX_SECONDS=30

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------
RAGBOT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
OPENAI_WEB_MODEL=gpt-4o-mini
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=

# Ollama alternative
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# -----------------------------------------------------------------------------
# Embeddings / vector store
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks
QDRANT_DIM=1536

# Recommended local multilingual retrieval baseline (Ollama, no fake API key
# required for localhost/loopback/host.docker.internal). Changing the embedding
# model/dimension requires re-indexing into a compatible Qdrant collection.
# EMBEDDING_MODEL=qwen3-embedding:0.6b
# EMBEDDING_BASE_URL=http://127.0.0.1:11434
# QDRANT_DIM=1024
# EMBEDDING_QUERY_INSTRUCTION=Given a user question, retrieve relevant passages that answer the question
EMBEDDING_ALLOW_ANONYMOUS=false

RAGBOT_RETRIEVAL_CANDIDATE_POOL=40
RAGBOT_RERANK_ENABLED=false
RAGBOT_RERANK_PROVIDER=cohere
RAGBOT_RERANK_MODEL=rerank-v3.5
RAGBOT_RERANK_API_KEY=
RAGBOT_RERANK_BASE_URL=
RAGBOT_RERANK_TOP_K=10

# -----------------------------------------------------------------------------
# PostgreSQL control plane / retrieval metadata
# -----------------------------------------------------------------------------
POSTGRES_USER=ragbot
POSTGRES_PASSWORD=ragbot
POSTGRES_DB=ragbot
# Used only by host/local development. The controller-managed Docker stack does
# not publish PostgreSQL to the host; API/worker/migrate use postgres:5432 on the
# private Compose network so host-side stale workers cannot claim Docker jobs.
POSTGRES_DSN=postgresql://ragbot:ragbot@localhost:5432/ragbot

# -----------------------------------------------------------------------------
# Optional Agent SQL query surface
# -----------------------------------------------------------------------------
RAGBOT_SQL_TOOL_ENABLED=false
RAGBOT_SQL_DSN=
RAGBOT_SQL_ALLOWED_SCHEMAS=
RAGBOT_SQL_LIMIT=200
RAGBOT_SQL_TIMEOUT_MS=3000

# -----------------------------------------------------------------------------
# API identity / tenant authorization
# -----------------------------------------------------------------------------
RAGBOT_API_KEYS=
# JSON keyed by API key. Required in production. Every production key must map
# to a stable user_id and either tenant_ids or admin=true. Non-admin production
# principals must include at least one platform role: reader/operator/owner.
# Capability hierarchy:
#   reader   = knowledge.query, catalog.read, feedback.write
#   operator = reader + source.create/update/sync + ingestion.run/retry
#   owner    = operator + source.delete
# Example operator:
# RAGBOT_API_KEY_PRINCIPALS={"replace-me":{"tenant_ids":["tenant-a"],"user_id":"svc-a","groups":["engineering"],"roles":["operator"],"admin":false}}
RAGBOT_API_KEY_PRINCIPALS=
RAGBOT_CORS_ORIGINS=http://localhost:3000
RAGBOT_API_PORT=8000

# -----------------------------------------------------------------------------
# Source-ingestion boundaries
# -----------------------------------------------------------------------------
# ragbot-data:/// references are executor-independent names for files below this
# managed data root. Docker overrides RAGBOT_DATA_DIR to /data inside containers.
RAGBOT_DATA_DIR=./data
RAGBOT_ALLOWED_LOCAL_SOURCE_ROOTS=/data

# Client-local PDF ingestion uses the server-managed UploadStore instead of
# persisting client filesystem paths. Filesystem is the development/single-node
# adapter. Local development derives tmp/ragbot-uploads when RAGBOT_UPLOAD_DIR
# is unset; production must configure an explicit shared root or a future
# object-store adapter. Docker Compose sets /var/lib/ragbot/uploads explicitly.
RAGBOT_UPLOAD_STORE=filesystem
# RAGBOT_UPLOAD_DIR=./tmp/ragbot-uploads
RAGBOT_UPLOAD_RETENTION_SECONDS=86400

RAGBOT_WEB_ALLOWED_HOSTS=
RAGBOT_PDF_ALLOWED_HOSTS=
RAGBOT_GIT_ALLOWED_HOSTS=
RAGBOT_ALLOW_PRIVATE_SOURCE_NETWORKS=false
RAGBOT_WEB_MAX_REDIRECTS=5
RAGBOT_PDF_MAX_REDIRECTS=5
RAGBOT_PDF_MAX_BYTES=26214400

RAGBOT_MINIO_ACCESS_KEY_ID=
RAGBOT_MINIO_SECRET_ACCESS_KEY=
RAGBOT_MINIO_SESSION_TOKEN=

CODE_REPO_ROOT=.

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
RAGBOT_TRACING_ENABLED=false
RAGBOT_OTEL_METRICS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
