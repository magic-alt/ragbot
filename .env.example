# Ragbot local-development configuration.
# Copy to .env and fill secrets locally. Never commit .env.

# -----------------------------------------------------------------------------
# Runtime mode
# -----------------------------------------------------------------------------
# development keeps in-memory/hash fallbacks available. production fails fast
# unless durable storage, semantic embeddings and scoped API principals exist.
RAGBOT_ENV=development

# Ingestion execution: auto uses the durable worker when POSTGRES_DSN is set and
# inline execution otherwise. Production forbids inline. Docker Compose sets
# this to worker and starts a dedicated worker service.
RAGBOT_INGESTION_MODE=auto
RAGBOT_WORKER_POLL_SECONDS=1
RAGBOT_WORKER_LEASE_SECONDS=120
RAGBOT_WORKER_MAX_ATTEMPTS=3
# Worker replicas safely share recurring Source scheduling. Set 0 to disable.
RAGBOT_SCHEDULER_SCAN_SECONDS=30

# -----------------------------------------------------------------------------
# LLM provider
# -----------------------------------------------------------------------------
RAGBOT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
OPENAI_WEB_MODEL=gpt-4o-mini
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=

# Ollama alternative
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# -----------------------------------------------------------------------------
# Embeddings / vector store
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks
QDRANT_DIM=1536

# Optional reranking. Retrieval falls back to RRF if this optional service fails.
RAGBOT_RERANK_ENABLED=false
RAGBOT_RERANK_PROVIDER=cohere
RAGBOT_RERANK_MODEL=rerank-v3.5
RAGBOT_RERANK_API_KEY=
RAGBOT_RERANK_BASE_URL=
RAGBOT_RERANK_TOP_K=10

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=ragbot
POSTGRES_PASSWORD=ragbot
POSTGRES_DB=ragbot
POSTGRES_DSN=postgresql://ragbot:ragbot@localhost:5432/ragbot
POSTGRES_ALLOWED_SCHEMAS=
POSTGRES_SQL_LIMIT=200
POSTGRES_SQL_TIMEOUT_MS=3000

# -----------------------------------------------------------------------------
# API identity / tenant authorization
# -----------------------------------------------------------------------------
# Empty credentials are for trusted local development only.
RAGBOT_API_KEYS=
# JSON keyed by API key. Required in production. Every production key must map
# to a stable user_id and either tenant_ids or admin=true.
# Example:
# RAGBOT_API_KEY_PRINCIPALS={"replace-me":{"tenant_ids":["tenant-a"],"user_id":"svc-a","groups":["engineering"],"roles":["reader"],"admin":false}}
RAGBOT_API_KEY_PRINCIPALS=
RAGBOT_CORS_ORIGINS=http://localhost:3000
RAGBOT_API_PORT=8000

# -----------------------------------------------------------------------------
# Source-ingestion boundaries
# -----------------------------------------------------------------------------
# Host directory mounted read-only to /data by Docker Compose.
RAGBOT_DATA_DIR=./data
# In production this must contain all roots from which local_fs, local PDF and
# local Git sources may read. Use the OS path separator for multiple roots.
RAGBOT_ALLOWED_LOCAL_SOURCE_ROOTS=/data
# Optional hostname allowlists. Comma-separated; '*.example.com' is supported.
RAGBOT_WEB_ALLOWED_HOSTS=
RAGBOT_PDF_ALLOWED_HOSTS=
RAGBOT_GIT_ALLOWED_HOSTS=
# Private/loopback/link-local destinations are blocked by default.
RAGBOT_ALLOW_PRIVATE_SOURCE_NETWORKS=false
RAGBOT_WEB_MAX_REDIRECTS=5
RAGBOT_PDF_MAX_REDIRECTS=5
RAGBOT_PDF_MAX_BYTES=26214400

# S3/MinIO credentials are deployment secrets, not Source.config values. An S3
# Source may set credential_env_prefix=RAGBOT_MINIO, which resolves these names:
RAGBOT_MINIO_ACCESS_KEY_ID=
RAGBOT_MINIO_SECRET_ACCESS_KEY=
RAGBOT_MINIO_SESSION_TOKEN=
# A MinIO Source supplies endpoint_url in its non-secret Source config, e.g.
# http://minio:9000. AWS S3 can rely on boto3's standard IAM/role credential chain.

# Code-search root is server-owned configuration, not a caller-supplied path.
CODE_REPO_ROOT=.

# -----------------------------------------------------------------------------
# Cache / observability
# -----------------------------------------------------------------------------
RAGBOT_CACHE_ENABLED=true
RAGBOT_CACHE_TTL_SECONDS=300
RAGBOT_CACHE_MAX_ENTRIES=1000
RAGBOT_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
