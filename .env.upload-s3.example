# Object-storage UploadStore example for Issue #59.
# Load alongside the normal .env / worker secret environment. Do not place
# provider credentials in Source.config or commit real credentials here.

RAGBOT_UPLOAD_STORE=s3
RAGBOT_UPLOAD_S3_BUCKET=ragbot-uploads
RAGBOT_UPLOAD_S3_PREFIX=ragbot/uploads
# Leave empty for AWS S3. Set an S3-compatible endpoint for MinIO/Ceph/etc.
RAGBOT_UPLOAD_S3_ENDPOINT_URL=
RAGBOT_UPLOAD_S3_REGION=ap-southeast-1

# Parser-local materialization. This is disposable cache/scratch, not the
# authoritative uploaded object location.
RAGBOT_UPLOAD_MATERIALIZE_DIR=/tmp/ragbot-upload-cache
RAGBOT_UPLOAD_MAX_OBJECT_BYTES=104857600

# boto3 multipart transfer bounds.
RAGBOT_UPLOAD_MULTIPART_THRESHOLD_BYTES=8388608
RAGBOT_UPLOAD_MULTIPART_CHUNK_BYTES=8388608
RAGBOT_UPLOAD_MAX_CONCURRENCY=4

# AWS/MinIO credentials use the normal SDK credential chain. Prefer workload
# identity / IAM role / secret injection in production. Static examples:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
