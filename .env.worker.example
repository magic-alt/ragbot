# Worker-only connector credentials for Docker Compose.
#
# Copy this file to .env.worker, fill only the credentials required by your
# enabled connectors, then point Compose at it:
#
#   RAGBOT_WORKER_ENV_FILE="$PWD/.env.worker" docker compose up -d --build
#
# .env.worker is ignored by git. The API service does not load this file.
# Source.config should reference these variables with credential_ref=env:NAME;
# never persist the secret values in Source/Job configuration.

# Google Drive access token or Google credential JSON, depending on
# source config credential_type.
RAGBOT_DRIVE_TOKEN=
RAGBOT_DRIVE_CREDENTIALS_JSON=

# Notion integration token.
RAGBOT_NOTION_TOKEN=

# Confluence API token / bearer token.
RAGBOT_CONFLUENCE_TOKEN=

# Add additional tenant- or integration-specific variables as needed, e.g.
# RAGBOT_TENANT_A_NOTION_TOKEN=
